TANOIMG_IMAGE=your-dockerhub-user/tanoimg:latest
TANOIMG_ADMIN_PASSWORD='replace-with-a-strong-password'
# Default: accessible only from this server (for a host reverse proxy).
# Set 0.0.0.0 only if direct access is intended and your firewall is configured.
TANOIMG_BIND=127.0.0.1
TANOIMG_PORT=3000
# Enable only behind a trusted reverse proxy that overwrites forwarding headers.
TANOIMG_TRUST_PROXY=false
